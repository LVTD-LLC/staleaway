# should be 'off' in prod
DEBUG=on

# options:
# - dev (for local development)
# - prod (for deployed versions)
ENVIRONMENT=dev

SECRET_KEY="super-secret-key"

SITE_URL=http://localhost:8000
# Production: https://staleaway.com

POSTGRES_HOST=db
POSTGRES_DB=staleaway
POSTGRES_USER=staleaway
POSTGRES_PORT=5432
POSTGRES_PASSWORD=staleaway

REDIS_HOST=redis
REDIS_PASSWORD=staleaway
REDIS_PORT=6379

# If you want to enable social auth via GitHub
# Get these values after creating a new app on GitHub: https://github.com/settings/applications/new
# For Homepage URL use: http://localhost:8000
# For Authorization callback URL use: http://localhost:8000/accounts/github/login/callback/
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# If you want to load blog post images to S3, instead of local storage
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=staleaway
AWS_SECRET_ACCESS_KEY=staleaway
AWS_S3_BUCKET_NAME=staleaway-dev

# Email is used for account confirmation, password reset, and Staleaway review digests.
# If you don't specify the key, account confirmation links are printed in the logs.
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=staleaway.com
DEFAULT_FROM_EMAIL="Rasul from Staleaway <rasul@staleaway.com>"

# Optional subscriber newsletter integration.
BUTTONDOWN_API_KEY=

# MJML URL for self-hosted server
MJML_URL=http://mjml:15500

# Optional integration keys.
OPENAI_API_KEY=

LOGFIRE_TOKEN=
LOGFIRE_CONSOLE_SHOW_PROJECT_LINK=False

SENTRY_DSN=
POSTHOG_API_KEY=

# Preserve the existing queue name when upgrading an installation.
Q_CLUSTER_NAME=staleaway-q

# Production cutover: pagefresh.lvtd.dev,cleanapp.dev,www.staleaway.com
LEGACY_HOSTS=
PLAUSIBLE_SITE_DOMAIN=staleaway.com
